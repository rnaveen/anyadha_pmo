  "content": "[{\"id\":\"anyadha_header\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h3\\\"><b>Outcomes and Performance</b></span>\",\"col\":12}},{\"id\":\"anyadha_intro\",\"type\":\"paragraph\",\"data\":{\"text\":\"<p>One Outcomes and Performance desk for Delivery PMO. Indicator and KPI DocTypes remain separate until the O-6 field-merge grill. Use impact tools only when the work needs them. GRC Review is assurance - not a substitute for operational outcomes here.</p>\",\"col\":12}},{\"id\":\"anyadha_metrics_header\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Metrics (shared direction)</b></span>\",\"col\":12}},{\"id\":\"anyadha_metrics_card\",\"type\":\"card\",\"data\":{\"card_name\":\"Metrics (shared direction - Indicator and KPI until O-6)\",\"col\":12}},{\"id\":\"anyadha_impact_header\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Impact pack (optional)</b></span>\",\"col\":12}},{\"id\":\"anyadha_impact_card\",\"type\":\"card\",\"data\":{\"card_name\":\"Impact pack (optional)\",\"col\":12}},{\"id\":\"anyadha_mgmt_header\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Management performance</b></span>\",\"col\":12}},{\"id\":\"anyadha_mgmt_card\",\"type\":\"card\",\"data\":{\"card_name\":\"Management performance\",\"col\":12}},{\"id\":\"anyadha_reports_header\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Reports</b></span>\",\"col\":12}},{\"id\":\"anyadha_reports_card\",\"type\":\"card\",\"data\":{\"card_name\":\"Reports\",\"col\":12}}]",
