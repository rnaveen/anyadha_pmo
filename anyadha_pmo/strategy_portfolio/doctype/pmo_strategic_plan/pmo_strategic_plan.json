      "label": "Plan",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "plan_name",
      "label": "Plan Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "plan_code",
      "label": "Plan Code",
