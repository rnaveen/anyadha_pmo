      "share": 0
    },
    {
      "role": "Executive / Management",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "email": 1,
      "export": 1,
      "share": 0
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "email": 1,
