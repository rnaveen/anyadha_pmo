{
  "doctype": "DocType",
  "name": "PMO Donor",
  "module": "PMO Masters",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "field:donor_name",
  "title_field": "donor_name",
  "show_title_field_in_link": 1,
  "search_fields": "donor_name,party_type",
  "field_order": [
    "section_party",
    "donor_name",
    "party_type",
    "column_break_party",
    "donor_type",
    "section_books",
    "erpnext_customer",
    "column_break_books",
    "erpnext_supplier",
    "section_contacts",
    "contacts",
    "contact_person",
    "email"
  ],
  "fields": [
    {
      "fieldname": "section_party",
      "label": "Party",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "donor_name",
      "label": "Party Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "party_type",
      "label": "Party Type",
      "fieldtype": "Select",
      "options": "Donor\nCSR Partner\nGovernment\nCommercial\nOther",
      "reqd": 1,
      "default": "Donor",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_party",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "donor_type",
      "label": "Donor Subtype",
      "fieldtype": "Select",
      "options": "Multilateral\nBilateral\nCorporate\nFoundation\nGovernment\nIndividual\nOther"
    },
    {
      "fieldname": "section_books",
      "label": "ERPNext books link",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "erpnext_customer",
      "label": "ERPNext Customer",
      "fieldtype": "Link",
      "options": "Customer"
    },
    {
      "fieldname": "column_break_books",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "erpnext_supplier",
      "label": "ERPNext Supplier",
      "fieldtype": "Link",
      "options": "Supplier"
    },
    {
      "fieldname": "section_contacts",
      "label": "Contacts",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "contacts",
      "label": "Contacts",
      "fieldtype": "Table",
      "options": "PMO Funding Party Contact"
    },
    {
      "fieldname": "contact_person",
      "label": "Contact Person (legacy)",
      "fieldtype": "Data",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "email",
      "label": "Email (legacy)",
      "fieldtype": "Data",
      "hidden": 1,
      "read_only": 1
    }
  ],
  "permissions": [
