    },
    {
      "fieldname": "program_name",
      "label": "Programme Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "program_code",
      "label": "Programme Code",
      "fieldtype": "Data",
      "in_list_view": 1
