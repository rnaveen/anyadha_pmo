  "fields": [
    {
      "fieldname": "section_deliverable",
      "label": "Deliverable",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "project",
      "label": "Project",
      "fieldtype": "Link",
      "options": "PMO Project",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "deliverable",
      "label": "Deliverable",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "deliverable_type",
      "label": "Deliverable Type",
      "fieldtype": "Select",
      "options": "UC\nSOE\nNarrative Report\nDonor Report\nCSR Report\nMilestone\nOther",
      "reqd": 1,
      "default": "Milestone",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_deliverable",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nPending\nSubmitted\nAccepted\nRejected\nOverdue\nClosed",
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "due_date",
      "label": "Due Date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "is_overdue",
      "label": "Overdue",
      "fieldtype": "Check",
      "read_only": 1
    },
    {
      "fieldname": "section_ownership",
      "label": "Ownership",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "responsible",
      "label": "Owner",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "column_break_ownership",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "reviewer",
      "label": "Reviewer",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "section_evidence",
      "label": "Evidence",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "attachment",
      "label": "Attachment",
      "fieldtype": "Attach"
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "acceptance_status",
      "label": "Acceptance Status (legacy)",
      "fieldtype": "Select",
      "options": "Pending\nAccepted\nRejected",
      "hidden": 1,
      "read_only": 1
    }
  ],
