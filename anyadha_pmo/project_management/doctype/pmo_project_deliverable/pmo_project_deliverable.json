{
  "doctype": "DocType",
  "name": "PMO Project Deliverable",
  "module": "Project Management",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "title_field": "deliverable",
  "show_title_field_in_link": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "section_deliverable",
    "project",
    "deliverable",
    "deliverable_type",
    "column_break_deliverable",
    "status",
    "due_date",
    "is_overdue",
    "section_ownership",
    "responsible",
